<section class="section section-warm" aria-label="Featured Decor">
  <div class="container">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 3rem; flex-wrap: wrap; gap: 1.5rem;">
      <div>
        <span class="section-eyebrow">Curated Accents</span>
        <h2 class="editorial-title">{{ section.settings.title | default: 'Featured Decor' }}</h2>
        <p class="section-subtext">Sculptural vessels, hand-finished mirrors and refined accents to complete your living environment.</p>
      </div>
      <div>
        <a href="/pages/home-decor" class="btn btn-outline">
          Explore All Decor →
        </a>
      </div>
    </div>

    <div class="product-grid">
      {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
        {%- for product in section.settings.collection.products limit: 4 -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        <!-- Demo Decor Products -->
        <div class="product-card" data-id="demo-decor-1" data-title="Round Decorative Mirror" data-price="28000" data-category="Mirrors">
          <div class="card-media-wrapper">
            <a href="/products/round-decorative-mirror">
              <img class="card-media-primary" src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=800&q=80" alt="Round Decorative Mirror" loading="lazy">
              <img class="card-media-secondary" src="https://images.unsplash.com/photo-1616594039964-ae9021a400a0?auto=format&fit=crop&w=800&q=80" alt="Round Decorative Mirror Angle" loading="lazy">
            </a>
            <div class="card-badges"><span class="badge-sale">Sale</span></div>
            <div class="card-quick-actions">
              <button type="button" class="card-action-btn" data-wishlist-toggle data-product-id="demo-decor-1" data-title="Round Decorative Mirror" data-price="28000" data-image="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=800&q=80" data-handle="round-decorative-mirror" aria-label="Add to wishlist">{% render 'icon', icon: 'heart' %}</button>
              <button type="button" class="card-action-btn" data-quick-view-btn data-id="demo-decor-1" data-title="Round Decorative Mirror" data-price="28000" data-compare-price="34000" data-image="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=800&q=80" data-category="Mirrors" data-url="/products/round-decorative-mirror" aria-label="Quick view">{% render 'icon', icon: 'eye' %}</button>
            </div>
            <div class="card-quick-add-wrap">
              <button type="button" class="btn btn-primary btn-sm btn-full" data-quick-add-id="v-decor-1" data-title="Round Decorative Mirror" data-price="28000" data-image="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=800&q=80">+ Quick Add</button>
            </div>
          </div>
          <div class="card-content">
            <span class="card-category">Mirrors</span>
            <h3 class="card-title"><a href="/products/round-decorative-mirror">Round Decorative Mirror</a></h3>
            <div class="card-price-row"><span class="price-regular">PKR 28,000</span><span class="price-compare">PKR 34,000</span></div>
          </div>
        </div>

        <div class="product-card" data-id="demo-decor-2" data-title="Textured Ceramic Vase" data-price="8500" data-category="Vases">
          <div class="card-media-wrapper">
            <a href="/products/textured-ceramic-vase">
              <img class="card-media-primary" src="https://images.unsplash.com/photo-1581783342308-f792dbdd27c5?auto=format&fit=crop&w=800&q=80" alt="Textured Ceramic Vase" loading="lazy">
              <img class="card-media-secondary" src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=800&q=80" alt="Textured Ceramic Vase Detail" loading="lazy">
            </a>
            <div class="card-quick-actions">
              <button type="button" class="card-action-btn" data-wishlist-toggle data-product-id="demo-decor-2" data-title="Textured Ceramic Vase" data-price="8500" data-image="https://images.unsplash.com/photo-1581783342308-f792dbdd27c5?auto=format&fit=crop&w=800&q=80" data-handle="textured-ceramic-vase" aria-label="Add to wishlist">{% render 'icon', icon: 'heart' %}</button>
              <button type="button" class="card-action-btn" data-quick-view-btn data-id="demo-decor-2" data-title="Textured Ceramic Vase" data-price="8500" data-image="https://images.unsplash.com/photo-1581783342308-f792dbdd27c5?auto=format&fit=crop&w=800&q=80" data-category="Vases" data-url="/products/textured-ceramic-vase" aria-label="Quick view">{% render 'icon', icon: 'eye' %}</button>
            </div>
            <div class="card-quick-add-wrap">
              <button type="button" class="btn btn-primary btn-sm btn-full" data-quick-add-id="v-decor-2" data-title="Textured Ceramic Vase" data-price="8500" data-image="https://images.unsplash.com/photo-1581783342308-f792dbdd27c5?auto=format&fit=crop&w=800&q=80">+ Quick Add</button>
            </div>
          </div>
          <div class="card-content">
            <span class="card-category">Vases</span>
            <h3 class="card-title"><a href="/products/textured-ceramic-vase">Textured Ceramic Vase</a></h3>
            <div class="card-price-row"><span class="price-regular">PKR 8,500</span></div>
          </div>
        </div>

        <div class="product-card" data-id="demo-decor-3" data-title="Modern Wall Decor" data-price="19500" data-category="Wall Decor">
          <div class="card-media-wrapper">
            <a href="/products/modern-wall-decor">
              <img class="card-media-primary" src="https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?auto=format&fit=crop&w=800&q=80" alt="Modern Wall Decor" loading="lazy">
              <img class="card-media-secondary" src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=800&q=80" alt="Modern Wall Decor Angle" loading="lazy">
            </a>
            <div class="card-badges"><span class="badge-sale">Sale</span></div>
            <div class="card-quick-actions">
              <button type="button" class="card-action-btn" data-wishlist-toggle data-product-id="demo-decor-3" data-title="Modern Wall Decor" data-price="19500" data-image="https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?auto=format&fit=crop&w=800&q=80" data-handle="modern-wall-decor" aria-label="Add to wishlist">{% render 'icon', icon: 'heart' %}</button>
              <button type="button" class="card-action-btn" data-quick-view-btn data-id="demo-decor-3" data-title="Modern Wall Decor" data-price="19500" data-compare-price="23000" data-image="https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?auto=format&fit=crop&w=800&q=80" data-category="Wall Decor" data-url="/products/modern-wall-decor" aria-label="Quick view">{% render 'icon', icon: 'eye' %}</button>
            </div>
            <div class="card-quick-add-wrap">
              <button type="button" class="btn btn-primary btn-sm btn-full" data-quick-add-id="v-decor-3" data-title="Modern Wall Decor" data-price="19500" data-image="https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?auto=format&fit=crop&w=800&q=80">+ Quick Add</button>
            </div>
          </div>
          <div class="card-content">
            <span class="card-category">Wall Decor</span>
            <h3 class="card-title"><a href="/products/modern-wall-decor">Modern Wall Decor</a></h3>
            <div class="card-price-row"><span class="price-regular">PKR 19,500</span><span class="price-compare">PKR 23,000</span></div>
          </div>
        </div>

        <div class="product-card" data-id="demo-decor-4" data-title="Decorative Showpiece" data-price="11200" data-category="Showpieces">
          <div class="card-media-wrapper">
            <a href="/products/decorative-showpiece">
              <img class="card-media-primary" src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=800&q=80" alt="Decorative Showpiece" loading="lazy">
              <img class="card-media-secondary" src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=800&q=80" alt="Decorative Showpiece Angle" loading="lazy">
            </a>
            <div class="card-quick-actions">
              <button type="button" class="card-action-btn" data-wishlist-toggle data-product-id="demo-decor-4" data-title="Decorative Showpiece" data-price="11200" data-image="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=800&q=80" data-handle="decorative-showpiece" aria-label="Add to wishlist">{% render 'icon', icon: 'heart' %}</button>
              <button type="button" class="card-action-btn" data-quick-view-btn data-id="demo-decor-4" data-title="Decorative Showpiece" data-price="11200" data-image="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=800&q=80" data-category="Showpieces" data-url="/products/decorative-showpiece" aria-label="Quick view">{% render 'icon', icon: 'eye' %}</button>
            </div>
            <div class="card-quick-add-wrap">
              <button type="button" class="btn btn-primary btn-sm btn-full" data-quick-add-id="v-decor-4" data-title="Decorative Showpiece" data-price="11200" data-image="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=800&q=80">+ Quick Add</button>
            </div>
          </div>
          <div class="card-content">
            <span class="card-category">Showpieces</span>
            <h3 class="card-title"><a href="/products/decorative-showpiece">Decorative Showpiece</a></h3>
            <div class="card-price-row"><span class="price-regular">PKR 11,200</span></div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Decor",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured Decor"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    }
  ],
  "presets": [
    {
      "name": "Featured Decor"
    }
  ]
}
{% endschema %}
