<div class="section" style="padding-top: 3rem;">
  <div class="container">
    {% render 'breadcrumbs' %}

    <div style="margin: 2rem 0 3.5rem; max-width: 800px;">
      <span class="section-eyebrow">Complete Architectural Catalog</span>
      <h1 class="editorial-title" style="font-size: clamp(2.5rem, 5vw, 4rem); margin-bottom: 1rem;">
        Lighting Gallery
      </h1>
      <p class="section-subtext">
        From statement focal chandeliers and traditional fanoos lanterns to minimal flush ceiling discs and intimate table lamps—discover lighting engineered for beauty and atmosphere.
      </p>
    </div>

    <!-- Lighting Category Editorial Grid -->
    <div style="display: flex; flex-direction: column; gap: 4rem;">
      <!-- Category 1: Fanoos -->
      <div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 3rem; align-items: center; background: var(--color-white); border: var(--border-hairline); border-radius: var(--radius-subtle); overflow: hidden;">
        <div style="padding: clamp(2rem, 4vw, 3.5rem);">
          <span class="section-eyebrow">Signature Illumination</span>
          <h2 class="editorial-title" style="font-size: 2.25rem; margin-bottom: 1rem;">Fanoos Lanterns</h2>
          <p class="section-subtext" style="margin-bottom: 2rem;">
            Decorative lanterns that cast intricate ambient silhouettes, blending historic filigree with clean contemporary brass framework.
          </p>
          <a href="/collections/fanoos" class="btn btn-primary">Browse Fanoos →</a>
        </div>
        <div style="height: 380px;">
          <img src="https://images.unsplash.com/photo-1513506003901-1e6a229e2d15?auto=format&fit=crop&w=1000&q=80" alt="Fanoos Collection" style="width: 100%; height: 100%; object-fit: cover;">
        </div>
      </div>

      <!-- Category 2: Chandeliers -->
      <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 3rem; align-items: center; background: var(--color-charcoal); color: var(--color-white); border-radius: var(--radius-subtle); overflow: hidden;">
        <div style="height: 380px;">
          <img src="https://images.unsplash.com/photo-1540932239986-30128078f3c5?auto=format&fit=crop&w=1000&q=80" alt="Chandeliers" style="width: 100%; height: 100%; object-fit: cover;">
        </div>
        <div style="padding: clamp(2rem, 4vw, 3.5rem);">
          <span class="section-eyebrow" style="color: var(--color-bronze-light);">Grand Presence</span>
          <h2 class="editorial-title" style="font-size: 2.25rem; margin-bottom: 1rem; color: var(--color-white);">Chandeliers</h2>
          <p style="color: var(--color-text-light-muted); margin-bottom: 2rem; line-height: 1.6;">
            Sculptural centerpieces designed for formal dining rooms, vaulted double-height ceilings, and expansive living rooms.
          </p>
          <a href="/collections/chandeliers" class="btn btn-primary">Shop Chandeliers →</a>
        </div>
      </div>

      <!-- Category 3: Pendant & Ceiling Lights -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
        <div style="background: var(--color-ivory-warm); border: var(--border-hairline); border-radius: var(--radius-subtle); padding: 2.5rem; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <span class="section-eyebrow">Focused Ambient</span>
            <h3 class="editorial-title" style="font-size: 1.85rem; margin-bottom: 0.75rem;">Pendant Lights</h3>
            <p class="section-subtext" style="margin-bottom: 1.5rem;">Slender cylindrical spotlights, fluted globes and single-drop pendants for kitchen islands and dining tables.</p>
          </div>
          <a href="/collections/pendant-lights" class="btn btn-outline btn-sm">Explore Pendants →</a>
        </div>

        <div style="background: var(--color-ivory-warm); border: var(--border-hairline); border-radius: var(--radius-subtle); padding: 2.5rem; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <span class="section-eyebrow">Flush Architecture</span>
            <h3 class="editorial-title" style="font-size: 1.85rem; margin-bottom: 0.75rem;">Ceiling Lights</h3>
            <p class="section-subtext" style="margin-bottom: 1.5rem;">Flush-mount architectural discs, halo rings and low-profile luminaires designed for spaces with standard clearances.</p>
          </div>
          <a href="/collections/ceiling-lights" class="btn btn-outline btn-sm">Explore Ceiling Lights →</a>
        </div>
      </div>

      <!-- Category 4: Wall Lights, Table & Floor Lamps -->
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.75rem;">
        <div class="product-card" style="padding: 2rem;">
          <span class="card-category">Vertical Depth</span>
          <h3 class="card-title" style="font-size: 1.5rem;">Wall Lights</h3>
          <p style="font-size: 0.875rem; color: var(--color-text-muted); margin: 0.5rem 0 1.5rem; line-height: 1.6;">Sconces and architectural up/down fixtures to texture walls.</p>
          <a href="/collections/wall-lights" class="btn btn-outline btn-sm">Shop Wall Lights →</a>
        </div>

        <div class="product-card" style="padding: 2rem;">
          <span class="card-category">Intimate Warmth</span>
          <h3 class="card-title" style="font-size: 1.5rem;">Table Lamps</h3>
          <p style="font-size: 0.875rem; color: var(--color-text-muted); margin: 0.5rem 0 1.5rem; line-height: 1.6;">Ceramic urn bases, brass finials and soft linen diffusion.</p>
          <a href="/collections/table-lamps" class="btn btn-outline btn-sm">Shop Table Lamps →</a>
        </div>

        <div class="product-card" style="padding: 2rem;">
          <span class="card-category">Standing Silhouettes</span>
          <h3 class="card-title" style="font-size: 1.5rem;">Floor Lamps</h3>
          <p style="font-size: 0.875rem; color: var(--color-text-muted); margin: 0.5rem 0 1.5rem; line-height: 1.6;">Arched bronze cantilevers and minimalist upright reading lamps.</p>
          <a href="/collections/floor-lamps" class="btn btn-outline btn-sm">Shop Floor Lamps →</a>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Lighting Landing",
  "settings": []
}
{% endschema %}
