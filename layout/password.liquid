<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }} &ndash; Opening Soon</title>
    {{ content_for_header }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="section-dark" style="min-height: 100vh; display: flex; align-items: center; justify-content: center; text-align: center;">
    <div class="container-narrow" style="padding: 3rem 1.5rem;">
      <span class="section-eyebrow">Riaz Home Decor Fanoos Light & Decor</span>
      <h1 class="editorial-title" style="margin: 1.5rem 0;">Illuminate Your Space</h1>
      <p style="color: var(--color-text-light-muted); max-width: 500px; margin: 0 auto 2rem;">
        Our showroom store is opening soon. Contact us at +92 300 7490606 or visit Bosan Road, Sabzazar Colony, Multan.
      </p>
      {{ content_for_layout }}
    </div>
  </body>
</html>
