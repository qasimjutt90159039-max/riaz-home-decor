<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#141413">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains 'Riaz Home Decor' %} &ndash; Riaz Home Decor Fanoos Light & Decor{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    <!-- Theme CSS -->
    {{ 'theme.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="template-{{ template.name | handle }} showroom-theme">
    <!-- Announcement Bar -->
    {% section 'announcement-bar' %}

    <!-- Sticky Main Header & Mega Menu -->
    {% section 'header' %}

    <!-- Main Content Container -->
    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- Master Showroom Footer -->
    {% section 'footer' %}

    <!-- Cart Drawer Component -->
    {% section 'cart-drawer' %}

    <!-- Search Overlay Component -->
    {% section 'search-overlay' %}

    <!-- Quick View Modal Component -->
    {% section 'quick-view-modal' %}

    <!-- Global Backdrop Overlay -->
    <div class="overlay-backdrop" aria-hidden="true"></div>

    <!-- Theme JavaScript Bundles -->
    {{ 'theme.js' | asset_url | script_tag }}
    {{ 'cart.js' | asset_url | script_tag }}
    {{ 'wishlist.js' | asset_url | script_tag }}
    {{ 'quick-view.js' | asset_url | script_tag }}
    {{ 'search.js' | asset_url | script_tag }}
    {{ 'filters.js' | asset_url | script_tag }}
  </body>
</html>
