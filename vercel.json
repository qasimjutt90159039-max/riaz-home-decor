{
  "version": 2,
  "cleanUrls": true,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/collections/:path*", "destination": "/shop.html" },
    { "source": "/products/product-vase", "destination": "/product-vase.html" },
    { "source": "/products/:path*", "destination": "/product-fanoos.html" },
    { "source": "/pages/:slug", "destination": "/$slug.html" }
  ]
}
