{% comment %}
  Riaz Home Decor - Pagination Snippet
{% endcomment %}

{%- if paginate.pages > 1 -%}
  <nav class="pagination-wrapper" style="display: flex; justify-content: center; gap: 0.5rem; margin-top: 3.5rem;" aria-label="Pagination">
    {%- if paginate.previous -%}
      <a href="{{ paginate.previous.url }}" class="btn btn-outline btn-sm" aria-label="Previous page">← Previous</a>
    {%- endif -%}

    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a href="{{ part.url }}" class="btn btn-outline btn-sm" style="min-width: 40px; padding: 0.6rem;">{{ part.title }}</a>
      {%- else -%}
        {%- if part.title == paginate.current_page -%}
          <span class="btn btn-primary btn-sm" style="min-width: 40px; padding: 0.6rem;">{{ part.title }}</span>
        {%- else -%}
          <span style="display: inline-flex; align-items: center; padding: 0 0.5rem;">{{ part.title }}</span>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" class="btn btn-outline btn-sm" aria-label="Next page">Next →</a>
    {%- endif -%}
  </nav>
{%- endif -%}
