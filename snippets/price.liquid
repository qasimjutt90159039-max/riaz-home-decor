{% comment %}
  Riaz Home Decor - Price Formatter Snippet
  Usage: {% render 'price', product: product, price_class: '' %}
{% endcomment %}

{%- liquid
  assign target = product.selected_or_first_available_variant
  assign compare_at_price = target.compare_at_price
  assign price = target.price | default: 1999
  assign available = target.available | default: true
  assign on_sale = false
  if compare_at_price > price
    assign on_sale = true
  endif
-%}

<div class="card-price-row {{ price_class }}">
  <span class="price-regular">{{ price | money }}</span>
  {%- if on_sale -%}
    <span class="price-compare">{{ compare_at_price | money }}</span>
  {%- endif -%}
  {%- unless available -%}
    <span style="font-size: 0.75rem; color: var(--color-terracotta); text-transform: uppercase; font-weight: 600;">Currently unavailable</span>
  {%- endunless -%}
</div>
