<div class="section" style="padding-top: 3.5rem;">
  <div class="container-narrow">
    {% render 'breadcrumbs' %}

    <div style="display: flex; justify-content: space-between; align-items: baseline; margin: 2rem 0 2.5rem; flex-wrap: wrap; gap: 1rem;">
      <div>
        <span class="section-eyebrow">Client Portal</span>
        <h1 class="editorial-title">Your Addresses</h1>
      </div>
      <div>
        <a href="/account" class="btn btn-outline btn-sm">← Return to Account</a>
      </div>
    </div>

    <div style="background: var(--color-white); border: var(--border-hairline); border-radius: var(--radius-subtle); padding: 2.5rem;">
      {%- paginate customer.addresses by 5 -%}
        {%- for address in customer.addresses -%}
          <div style="border-bottom: 1px solid var(--color-sand); padding-bottom: 1.5rem; margin-bottom: 1.5rem;">
            {%- if address == customer.default_address -%}
              <span class="badge-tag" style="margin-bottom: 0.5rem; display: inline-block;">Default</span>
            {%- endif -%}
            <div style="font-size: 0.95rem; line-height: 1.8; color: var(--color-charcoal);">
              {{ address | format_address }}
            </div>
          </div>
        {%- endfor -%}
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    </div>
  </div>
</div>
