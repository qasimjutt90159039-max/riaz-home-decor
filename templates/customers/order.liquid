<div class="section" style="padding-top: 3.5rem;">
  <div class="container-narrow">
    {% render 'breadcrumbs' %}

    <div style="display: flex; justify-content: space-between; align-items: baseline; margin: 2rem 0 2.5rem; flex-wrap: wrap; gap: 1rem;">
      <div>
        <span class="section-eyebrow">Order Reference</span>
        <h1 class="editorial-title">Order {{ order.name }}</h1>
        <p style="color: var(--color-text-muted); font-size: 0.875rem;">Placed on {{ order.created_at | date: "%B %d, %Y %I:%M%p" }}</p>
      </div>
      <div>
        <a href="/account" class="btn btn-outline btn-sm">← Back to Account</a>
      </div>
    </div>

    <div style="background: var(--color-white); border: var(--border-hairline); border-radius: var(--radius-subtle); padding: 2.5rem;">
      <table style="width: 100%; border-collapse: collapse; font-size: 0.9375rem; margin-bottom: 2rem;">
        <thead>
          <tr style="border-bottom: 2px solid var(--color-sand); text-align: left;">
            <th style="padding: 0.75rem 0;">Product</th>
            <th style="padding: 0.75rem 0;">Price</th>
            <th style="padding: 0.75rem 0;">Qty</th>
            <th style="padding: 0.75rem 0; text-align: right;">Total</th>
          </tr>
        </thead>
        <tbody>
          {%- for line_item in order.line_items -%}
            <tr style="border-bottom: 1px solid var(--color-sand);">
              <td style="padding: 1rem 0;">{{ line_item.title }}</td>
              <td style="padding: 1rem 0;">{{ line_item.final_price | money }}</td>
              <td style="padding: 1rem 0;">{{ line_item.quantity }}</td>
              <td style="padding: 1rem 0; text-align: right; font-weight: 600;">{{ line_item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>

      <div style="display: flex; justify-content: flex-end;">
        <div style="max-width: 300px; width: 100%; font-size: 0.95rem; line-height: 2;">
          <div style="display: flex; justify-content: space-between;">
            <span>Subtotal</span>
            <span>{{ order.line_items_subtotal_price | money }}</span>
          </div>
          <div style="display: flex; justify-content: space-between; font-weight: 700; font-size: 1.15rem; border-top: 1px solid var(--color-sand); padding-top: 0.5rem; margin-top: 0.5rem;">
            <span>Total</span>
            <span>{{ order.total_net_amount | money }}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
